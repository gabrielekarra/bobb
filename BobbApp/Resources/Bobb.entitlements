<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.virtualization</key>
    <true/>
    <!-- Hardened runtime blocks Apple Events without this: it is what lets
         Bobb read the open message in Mail and open a reply window. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
    <!-- Hardened runtime blocks calendar access without this; it is used
         only to read events for meeting briefs, never to change them. -->
    <key>com.apple.security.personal-information.calendars</key>
    <true/>
    <!-- Only while the user talks to Bobb; recognition runs on-device. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
